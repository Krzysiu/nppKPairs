#include <windows.h>
#include <commctrl.h>
#include "resource.h"
#include "app_meta.h"
LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US
1 VERSIONINFO
 FILEVERSION APP_VERSION_NUM
 PRODUCTVERSION APP_VERSION_NUM
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904b0"
  BEGIN
   VALUE "CompanyName", APP_AUTHOR
   VALUE "FileDescription", "KPairs - Find and replace library for Notepad++"
   VALUE "FileVersion", APP_VERSION_FILE
   VALUE "InternalName", APP_NAME
   VALUE "OriginalFilename", "KPairs.dll"
   VALUE "ProductName", APP_NAME
   VALUE "ProductVersion", APP_VER
   VALUE "LegalCopyright", "Krzysztof Blachnicki. GPL-3.0-or-later."
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x409, 1200
 END
END
LICENSE_TEXT RCDATA "LICENSE"
ID_PANEL DIALOGEX 0,0,245,380
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD | WS_CLIPCHILDREN | WS_CLIPSIBLINGS
EXSTYLE WS_EX_CONTROLPARENT
FONT 9,"Segoe UI"
BEGIN
 EDITTEXT P_SEARCH,6,6,230,15,ES_AUTOHSCROLL
 AUTORADIOBUTTON "AND",P_AND,6,26,45,15,WS_GROUP
 AUTORADIOBUTTON "OR",P_OR,54,26,40,15
 AUTORADIOBUTTON "FULL",P_FULL,100,26,48,15
 PUSHBUTTON "A-Z",P_SORTNAME,153,26,38,17
 PUSHBUTTON "Date",P_SORTDATE,195,26,40,17
 PUSHBUTTON "Add",P_ADD,6,48,45,17
 PUSHBUTTON "Edit",P_EDIT,55,48,45,17
 PUSHBUTTON "Duplicate",P_DUP,104,48,65,17
 PUSHBUTTON "Delete",P_DELETE,173,48,45,17
 PUSHBUTTON "...",P_MORE,220,48,22,17
 CONTROL "",P_LIST,"SysListView32",WS_TABSTOP|WS_BORDER|LVS_REPORT|LVS_SINGLESEL|LVS_NOCOLUMNHEADER|LVS_SHOWSELALWAYS,6,72,230,220
 LTEXT "Temporary scope",P_HINT,6,300,230,12
 COMBOBOX P_SCOPE,6,315,230,80,CBS_DROPDOWNLIST|WS_TABSTOP|WS_VSCROLL
 PUSHBUTTON "Preview",P_PREVIEW,6,340,110,20
 PUSHBUTTON "Replace all",P_RUN,122,340,114,20
 LTEXT "",P_STATUS,6,365,230,12,SS_ENDELLIPSIS
END

#include <commctrl.h>

