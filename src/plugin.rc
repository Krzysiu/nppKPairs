 AUTOCHECKBOX "Use group setting",I_MODE,310,208,135,14
 AUTOCHECKBOX "Use group setting",I_SCOPE,310,232,135,14
 AUTOCHECKBOX "Use group setting",I_CASE,310,256,135,14
 AUTOCHECKBOX "Use group setting",I_COLOR,310,280,135,14
 AUTOCHECKBOX "Use group setting",I_MASK,310,320,135,14
 AUTOCHECKBOX "Use group setting",I_DIR,310,349,135,14
 AUTOCHECKBOX "Use group setting",I_RECURSIVE,310,376,135,14
 

